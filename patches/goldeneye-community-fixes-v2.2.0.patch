+  const bool watch_open = player && LD32(base, GE_PAUSE_FLAG) != 0u &&
+                          LD32(base, player + GE_OFF_WATCH) != 0u;
+  if (watch_open == previous_watch_open) return;
+  previous_watch_open = watch_open;
